# Tokenix dashboard environment.
# Copy to `.env.local` for local dev; set the same keys in the Vercel project
# for deployments. `.env.local` is gitignored — never commit real values.

# ── Analytics API ───────────────────────────────────────────────────────────
# Base URL of the Tokenix analytics API (apps/analytics-api in the ai-gateway
# repo). Read server-side only, by lib/tokenix-api.ts.
#
# The code falls back to http://localhost:8001 when this is unset, which is
# correct locally but WRONG in production: a deployed dashboard would try to
# reach its own container's localhost and 503 on every page under app/(app)/.
# Set this explicitly in Vercel to the deployed analytics URL.
#
#   local docker stack   http://localhost:8001
#   local stub server    http://127.0.0.1:8001   (tools/stub_analytics.py)
#   production           https://analytics.tokenixindex.com
TOKENIX_ANALYTICS_URL=http://localhost:8001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
INTERNAL_API_TOKEN=paste-your-token-here
TOKENIX_ADMIN_TOKEN=local-dev-admin-token
TOKENIX_GATEWAY_URL=https://cozy-patience-production-815c.up.railway.app